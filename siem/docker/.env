ELASTIC_USERNAME=elastic # also used for dashboard login

# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=changemepls # also used for dashboard login

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=changemeplstoo

# Password used for the 'vector_writer' Elasticsearch user
VECTOR_PASSWORD=changealsome

# Version of Elastic products
STACK_VERSION=8.17.3

# Set the cluster name
CLUSTER_NAME=docker-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Version of Vector
VECTOR_VERSION=0.43.0

# Port to expose Vector to the host
VECTOR_PORT=6000

# Elasticsearch container memory ceiling AND JVM heap size.
#
# Without ES_JAVA_OPTS, Elasticsearch's default heap auto-sizing targets
# ~50% of the HOST's total visible RAM (not the actual data volume) --
# confirmed live: this deployment's actual indexed data totals under
# 500MB (a handful of honeypot-* daily indices), yet es01 was sitting at
# ~8.3GB heap because the host has ~15.5GB RAM and no limit was set here
# (this mem_limit line was present but commented out/dead). 1g heap / 3g
# container below is generous headroom over the current dataset; raise
# both if log volume grows substantially (e.g. more log sources, longer
# retention).
ES_MEM_LIMIT=3221225472  #3g -- 1g JVM heap + headroom; confirmed live that
# a 2g container limit sat at ~93% steady-state with only 1g heap actually
# in use (mmap'd Lucene index-file cache counts against the cgroup limit
# too, on top of heap) -- close enough to risk an OOM-kill on a load
# spike, so bumped for safety margin without touching the heap itself.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Kibana container memory ceiling -- same previously-dead-mem_limit issue
# as ES above (no JVM here, so no separate heap flag needed, just the
# container ceiling). Kibana's actual usage runs ~500MB; 1g leaves headroom.
KIBANA_MEM_LIMIT=1073741824  #1g


# Project namespace (defaults to the current folder name if not set)
#COMPOSE_PROJECT_NAME=myproject
