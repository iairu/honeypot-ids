# threshold.config
# 
# This file contains threshold settings for Suricata rules to prevent
# alert flooding and manage rule firing frequency.
#
# Format: threshold gen_id <gid>, sig_id <sid>, type <limit|threshold|both>, 
#         track <by_src|by_dst>, count <N>, seconds <T>
#
# Types:
# - limit: Alert only on the first match within the time period
# - threshold: Alert only after N matches within the time period  
# - both: Alert once per time period after N matches
#
# Track options:
# - by_src: Track by source IP
# - by_dst: Track by destination IP

# WordPress brute force protection
threshold gen_id 1, sig_id 1000017, type limit, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000057, type limit, track by_src, count 3, seconds 60

# Rate limiting for high volume attacks
threshold gen_id 1, sig_id 1000056, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000067, type threshold, track by_src, count 10, seconds 60
threshold gen_id 1, sig_id 1000068, type limit, track by_src, count 1, seconds 120

# Plugin enumeration protection
threshold gen_id 1, sig_id 1000049, type threshold, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000050, type threshold, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000051, type threshold, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000052, type threshold, track by_src, count 3, seconds 60

# Honeypot triggers - more sensitive
threshold gen_id 1, sig_id 1000058, type threshold, track by_src, count 2, seconds 300
threshold gen_id 1, sig_id 1000059, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000060, type threshold, track by_src, count 3, seconds 60

# Generic attack pattern thresholds
threshold gen_id 1, sig_id 1000026, type limit, track by_src, count 3, seconds 60
threshold gen_id 1, sig_id 1000027, type limit, track by_src, count 3, seconds 60
threshold gen_id 1, sig_id 1000028, type limit, track by_src, count 3, seconds 60
threshold gen_id 1, sig_id 1000029, type limit, track by_src, count 3, seconds 60

# XSS pattern thresholds
threshold gen_id 1, sig_id 1000030, type limit, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000031, type limit, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000032, type limit, track by_src, count 5, seconds 60

# Command injection thresholds
threshold gen_id 1, sig_id 1000033, type limit, track by_src, count 2, seconds 60
threshold gen_id 1, sig_id 1000034, type limit, track by_src, count 2, seconds 60
threshold gen_id 1, sig_id 1000035, type limit, track by_src, count 2, seconds 60

# Directory traversal thresholds
threshold gen_id 1, sig_id 1000036, type limit, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000037, type limit, track by_src, count 5, seconds 60
threshold gen_id 1, sig_id 1000038, type limit, track by_src, count 3, seconds 60

# File inclusion thresholds
threshold gen_id 1, sig_id 1000039, type limit, track by_src, count 3, seconds 60
threshold gen_id 1, sig_id 1000040, type limit, track by_src, count 3, seconds 60
threshold gen_id 1, sig_id 1000041, type limit, track by_src, count 3, seconds 60

# Malicious user agent detection - be more permissive for legitimate tools
threshold gen_id 1, sig_id 1000042, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000043, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000044, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000045, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000046, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000047, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000048, type limit, track by_src, count 1, seconds 300

# File upload attempt thresholds
threshold gen_id 1, sig_id 1000053, type limit, track by_src, count 3, seconds 60
threshold gen_id 1, sig_id 1000054, type limit, track by_src, count 1, seconds 120
threshold gen_id 1, sig_id 1000055, type limit, track by_src, count 1, seconds 120

# Session anomaly detection
threshold gen_id 1, sig_id 1000061, type threshold, track by_src, count 3, seconds 300
threshold gen_id 1, sig_id 1000062, type threshold, track by_src, count 3, seconds 300
threshold gen_id 1, sig_id 1000063, type limit, track by_src, count 1, seconds 60

# Generic code injection and exploit attempts
threshold gen_id 1, sig_id 1000064, type limit, track by_src, count 2, seconds 60
threshold gen_id 1, sig_id 1000065, type limit, track by_src, count 2, seconds 60
threshold gen_id 1, sig_id 1000066, type limit, track by_src, count 3, seconds 60

# Webshell and backdoor detection
threshold gen_id 1, sig_id 1000069, type limit, track by_src, count 1, seconds 300
threshold gen_id 1, sig_id 1000070, type limit, track by_src, count 2, seconds 120