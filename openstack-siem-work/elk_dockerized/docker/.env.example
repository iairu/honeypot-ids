ELASTIC_USERNAME=elastic # also used for dashboard login

# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=change_this_elastic_password_in_production # also used for dashboard login

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=change_this_kibana_system_password_in_production

# Password used for the 'vector_writer' Elasticsearch user
VECTOR_PASSWORD=change_this_vector_writer_password_in_production

# Version of Elastic products
STACK_VERSION=8.17.3

# Set the cluster name
CLUSTER_NAME=docker-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Version of Vector
VECTOR_VERSION=0.43.0

# Port to expose Vector to the host
VECTOR_PORT=6000

# Increase or decrease based on the available host memory (in bytes)
#ES_MEM_LIMIT=21474836480  #20g
#ES_MEM_LIMIT=15032385536 #14g

#KIBANA_MEM_LIMIT=4294967296  #4g


# Project namespace (defaults to the current folder name if not set)
#COMPOSE_PROJECT_NAME=myproject

# Notes:
# - Generate strong random passwords for production deployment (the
#   dashboard/ app's Settings page has a "Generate" button per secret
#   field, or use `openssl rand -base64 32` by hand).
# - Never commit the actual .env file to version control.
# - Certificates (CA + es01/kibana/vector/vector-agent) are generated
#   separately -- run certs/root-ca/gen_elk_certs.sh (or the dashboard's
#   Certificates page) before `docker compose up`, not configured here.
# - See ../../../ARCHITECTURE.md for how this project relates to
#   openstack-work/ (the edge honeypot) -- two independent compose
#   projects, meant for two separate hosts, with instructions for running
#   both on one host for testing.
