# ELK SIEM Stack Configuration
# Copy this file to .env and update with your values

# Stack version - Update periodically for security patches
STACK_VERSION=8.11.0

# Elasticsearch Configuration
ES_PORT=9200
# ES_MEM_LIMIT=2g  # Uncomment to set memory limit (default: uses available RAM)

# Elasticsearch Authentication
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=ChangeMe_SecureElasticPassword123!  # CHANGE THIS!

# Kibana Configuration
KIBANA_PORT=5601
# KIBANA_MEM_LIMIT=1g  # Uncomment to set memory limit

# Kibana Authentication (kibana_system user)
KIBANA_PASSWORD=ChangeMe_SecureKibanaPassword123!  # CHANGE THIS!

# Logstash Configuration
LOGSTASH_PORT=9600  # Management API port
# Beats input port (5044) is configured in docker-compose.yml

# Security Notes:
# 1. Use strong, unique passwords (minimum 12 characters)
# 2. Never commit this file to version control
# 3. Keep passwords secure and rotate them regularly
# 4. Consider using password manager or secrets management tool
